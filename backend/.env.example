# Project Configuration & Client White-labeling
PROJECT_NAME="AgentPulse Enterprise AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# API Server Settings
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# LLM Providers (Configure whichever client provides or leave empty to test mock engine)
LLM_PROVIDER="ollama" # ollama | anthropic | openai | mock
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Search Provider (Tavily, SerpApi, or free DuckDuckGo fallback)
SEARCH_PROVIDER="duckduckgo" # duckduckgo | tavily
TAVILY_API_KEY=""

# Monetization & Rate Limiting
MAX_CONCURRENT_TASKS=5
TOKEN_BUDGET_PER_RUN=40000

